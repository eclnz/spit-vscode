{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SPIT",
  "scopeName": "source.spit",
  "patterns": [
    { "include": "#comments" },
    { "include": "#section-headers" },
    { "include": "#stage-header" },
    { "include": "#discover-line" },
    { "include": "#recipe-header" },
    { "include": "#use-line" },
    { "include": "#check-declaration" },
    { "include": "#flow-declaration" },
    { "include": "#drop-rule" },
    { "include": "#exclude-rule" },
    { "include": "#constraint-rule" },
    { "include": "#invocation" },
    { "include": "#operation-signature" },
    { "include": "#product-declaration" },
    { "include": "#inventory-entry" },
    { "include": "#context-entry" },
    { "include": "#command-line" },
    { "include": "#expression" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.spit",
          "match": "#.*$"
        }
      ]
    },
    "section-headers": {
      "patterns": [
        {
          "match": "^\\s*(contexts)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(:)\\s*$",
          "captures": {
            "1": { "name": "keyword.other.section.spit" },
            "2": { "name": "entity.name.section.discovery.spit" },
            "3": { "name": "punctuation.separator.colon.spit" }
          }
        },
        {
          "name": "entity.name.section.spit keyword.other.section.spit",
          "match": "^\\s*(sources|source_paths|contexts|removed)\\s*:\\s*$"
        }
      ]
    },
    "stage-header": {
      "comment": "`stage name:` opens a stage; its lines are indented beneath it.",
      "match": "^\\s*(stage)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(:)(?=\\s*(?:#.*)?$)",
      "captures": {
        "1": { "name": "keyword.control.stage.spit" },
        "2": { "name": "entity.name.section.stage.spit" },
        "3": { "name": "punctuation.separator.colon.spit" }
      }
    },
    "discover-line": {
      "comment": "Discover observed entity bindings from matching directories.",
      "begin": "^(\\s*)(discover)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(:)\\s*(\\[)([^\\]]*)(\\])\\s+(from)\\s+(dirs)\\s+",
      "beginCaptures": {
        "2": { "name": "keyword.control.discovery.spit" },
        "3": { "name": "entity.name.collection.spit" },
        "4": { "name": "punctuation.separator.colon.spit" },
        "5": { "name": "punctuation.definition.dimensions.begin.spit" },
        "6": { "patterns": [{ "include": "#dimension-list-inner" }] },
        "7": { "name": "punctuation.definition.dimensions.end.spit" },
        "8": { "name": "keyword.control.discovery.spit" },
        "9": { "name": "keyword.other.discovery.spit" }
      },
      "end": "$",
      "patterns": [{ "include": "#word-comment" }, { "include": "#brace-escape" }, { "include": "#path-placeholder" }]
    },
    "strings": {
      "patterns": [
        {
          "comment": "SPIT fills placeholders in double quotes; single-quoted text is literal, as in Bash.",
          "name": "string.quoted.double.spit",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "name": "constant.character.escape.spit", "match": "\\\\." }, { "include": "#placeholder" }]
        },
        {
          "name": "string.quoted.single.spit",
          "begin": "'",
          "end": "'",
          "patterns": [{ "name": "constant.character.escape.spit", "match": "\\\\." }]
        }
      ]
    },
    "recipe-header": {
      "comment": "A .spitin names the pipeline it serves, `pipeline analysis.spit`, and may name its dataset root, `root data`, which a .spitout also records.",
      "match": "^(\\s*)(pipeline|root)\\s+([^\\s=:#][^#]*?)\\s*(?=#|$)",
      "captures": {
        "2": { "name": "keyword.control.import.spit" },
        "3": { "name": "string.unquoted.file.spit" }
      }
    },
    "use-line": {
      "begin": "^(\\s*)(use)\\s+",
      "beginCaptures": {
        "2": { "name": "keyword.control.import.spit" }
      },
      "end": "$",
      "patterns": [
        { "name": "keyword.control.import.spit", "match": "\\b(from|as)\\b" },
        { "include": "#strings" },
        { "name": "punctuation.separator.comma.spit", "match": "," },
        { "name": "variable.other.spit", "match": "[A-Za-z_][A-Za-z0-9_]*" }
      ]
    },
    "flow-declaration": {
      "patterns": [
        {
          "match": "^(\\s*)(source)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "2": { "name": "keyword.control.spit" },
            "3": { "name": "variable.other.product.spit" }
          }
        },
        {
          "comment": "`dimensions [...]`: the order every product's dimensions follow.",
          "match": "^(\\s*)(dimensions)\\s+(\\[[^\\]]*\\])",
          "captures": {
            "2": { "name": "keyword.control.spit" },
            "3": { "name": "meta.dimension-list.spit", "patterns": [{ "include": "#dimension-list-inner" }] }
          }
        },
        {
          "match": "^(\\s*)(command)\\s+",
          "captures": { "2": { "name": "keyword.control.spit" } }
        },
        {
          "comment": "`ext:`, the extension a default path is completed with.",
          "match": "^(\\s*)(ext)\\s*(:)(?![^#]*=)\\s*((?:\\.[A-Za-z0-9_-]+)+)?",
          "captures": {
            "2": { "name": "keyword.control.spit" },
            "3": { "name": "punctuation.separator.colon.spit" },
            "4": { "name": "constant.other.extension.spit" }
          }
        },
        {
          "comment": "`path:` or `path product:`, then a template.",
          "begin": "^(\\s*)(path)(?:\\s+([A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*))?\\s*(:)",
          "beginCaptures": {
            "2": { "name": "keyword.control.spit" },
            "3": { "name": "variable.other.product.spit" },
            "4": { "name": "punctuation.separator.colon.spit" }
          },
          "end": "$",
          "patterns": [{ "include": "#word-comment" }, { "include": "#brace-escape" }, { "include": "#path-group" }, { "include": "#path-placeholder" }]
        }
      ]
    },
    "constraint-rule": {
      "match": "^(\\s*)(require)\\s+(\\[[^\\]]*\\])\\s+(where)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s+(count)(!=|>=|<=|=|>|<)(\\d+)|\\s+(has)\\s+([A-Za-z_][A-Za-z0-9_]*)(=))",
      "captures": {
        "2": { "name": "keyword.control.constraint.spit" },
        "3": { "name": "meta.dimension-list.spit" },
        "4": { "name": "keyword.control.constraint.spit" },
        "5": { "name": "variable.other.product.spit" },
        "6": { "name": "keyword.other.count.spit" },
        "7": { "name": "keyword.operator.comparison.spit" },
        "8": { "name": "constant.numeric.spit" },
        "9": { "name": "keyword.control.constraint.spit" },
        "10": { "name": "variable.parameter.dimension.spit" },
        "11": { "name": "keyword.operator.comparison.spit" }
      },
      "patterns": [{ "include": "#dimension-list-inner" }]
    },
    "drop-rule": {
      "match": "^(\\s*)(drop)\\s+(\\[[^\\]]*\\])\\s+(where)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s+(count)(!=|>=|<=|=|>|<)(\\d+)|\\s+(missing|has)\\s+([A-Za-z_][A-Za-z0-9_]*)(=))",
      "captures": {
        "2": { "name": "keyword.control.constraint.spit" },
        "3": { "name": "meta.dimension-list.spit" },
        "4": { "name": "keyword.control.constraint.spit" },
        "5": { "name": "variable.other.product.spit" },
        "6": { "name": "keyword.other.count.spit" },
        "7": { "name": "keyword.operator.comparison.spit" },
        "8": { "name": "constant.numeric.spit" },
        "9": { "name": "keyword.control.constraint.spit" },
        "10": { "name": "variable.parameter.dimension.spit" },
        "11": { "name": "keyword.operator.comparison.spit" }
      },
      "patterns": [{ "include": "#dimension-list-inner" }]
    },
    "exclude-rule": {
      "patterns": [
        {
          "match": "^(\\s*)(exclude)\\s+(from)\\s+([^#]+)",
          "captures": {
            "2": { "name": "keyword.control.constraint.spit" },
            "3": { "name": "keyword.control.constraint.spit" },
            "4": { "name": "string.unquoted.file.spit" }
          }
        },
        {
          "match": "^(\\s*)(exclude)\\s+(?:([A-Za-z_][A-Za-z0-9_]*)?)(\\[[^\\]]*\\])?",
          "captures": {
            "2": { "name": "keyword.control.constraint.spit" },
            "3": { "name": "variable.other.product.spit" },
            "4": { "name": "meta.dimension-list.spit" }
          }
        }
      ]
    },
    "check-declaration": {
      "comment": "`check name(params): command`: a test of one artifact, which reads `{@path}` and each `{param}`. A step's product named `check` takes `=`, so it is not one.",
      "begin": "^(\\s*)(check)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?:(\\()([^()]*)(\\)))?\\s*(:)",
      "beginCaptures": {
        "2": { "name": "keyword.control.spit" },
        "3": { "name": "entity.name.function.check.spit" },
        "4": { "name": "punctuation.section.parens.spit" },
        "5": {
          "patterns": [
            { "name": "variable.parameter.spit", "match": "[A-Za-z_][A-Za-z0-9_]*" },
            { "name": "punctuation.separator.comma.spit", "match": "," }
          ]
        },
        "6": { "name": "punctuation.section.parens.spit" },
        "7": { "name": "punctuation.separator.colon.spit" }
      },
      "end": "$",
      "patterns": [
        { "include": "#placeholder" }
      ]
    },
    "check-clause": {
      "comment": "`check(nonempty, ndim(3))` after `@`: the checks a port or a source attaches, each a name with its arguments.",
      "begin": "\\b(check)\\s*(\\()",
      "beginCaptures": {
        "1": { "name": "keyword.other.selector.spit" },
        "2": { "name": "punctuation.section.parens.spit" }
      },
      "end": "\\)",
      "endCaptures": {
        "0": { "name": "punctuation.section.parens.spit" }
      },
      "patterns": [
        {
          "match": "([A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*)\\s*(\\()([^()]*)(\\))",
          "captures": {
            "1": { "name": "entity.name.function.check.spit" },
            "2": { "name": "punctuation.section.parens.spit" },
            "3": {
              "patterns": [
                { "name": "punctuation.separator.comma.spit", "match": "," },
                { "name": "constant.other.argument.spit", "match": "[^,\\s]+" }
              ]
            },
            "4": { "name": "punctuation.section.parens.spit" }
          }
        },
        { "name": "entity.name.function.check.spit", "match": "[A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*" },
        { "name": "punctuation.separator.comma.spit", "match": "," }
      ]
    },
    "operation-signature": {
      "begin": "^(\\s*)(operation)\\s+([A-Za-z_][A-Za-z0-9_]*)(\\()",
      "beginCaptures": {
        "2": { "name": "keyword.control.spit" },
        "3": { "name": "entity.name.function.spit" },
        "4": { "name": "punctuation.definition.parameters.begin.spit" }
      },
      "end": "\\)\\s*(->)\\s*((?:[^@#]|@\\s*check\\s*\\((?:[^()]|\\([^()]*\\))*\\))*)|\\)",
      "endCaptures": {
        "1": { "name": "keyword.operator.arrow.spit" },
        "2": {
          "name": "meta.operation.output.spit",
          "patterns": [
            { "include": "#check-clause" },
            { "name": "keyword.operator.at.spit", "match": "@" },
            { "name": "string.quoted.double.spit", "match": "\"[^\"]*\"" },
            { "name": "keyword.other.beside.spit", "match": "\\bbeside\\b" },
            {
              "comment": "A `/` that makes the output a folder, alone or after its extension: `-> (subject: FsSubject /)`, `-> Zarr .zarr/`.",
              "name": "constant.other.extension.folder.spit",
              "match": "(?<![A-Za-z0-9_])(?:(?:\\.[A-Za-z0-9_-]+)+)?/"
            },
            {
              "comment": "The extension the tool gives an output's file: `-> Transform .mat`.",
              "name": "constant.other.extension.spit",
              "match": "(?<![A-Za-z0-9_])(?:\\.[A-Za-z0-9_-]+)+"
            },
            { "include": "#type-reference" },
            { "name": "variable.parameter.port.spit", "match": "\\b[a-z_][A-Za-z0-9_]*\\b" },
            { "name": "punctuation.separator.comma.spit", "match": "," },
            { "name": "punctuation.separator.colon.spit", "match": ":" },
            { "name": "punctuation.section.parens.spit", "match": "[()]" }
          ]
        }
      },
      "patterns": [
        { "include": "#check-clause" },
        {
          "comment": "A many input's minimum, `items: many Image @ min(2)`, matched whole so the `)` of `min(2)` does not end the inputs.",
          "match": "(@)\\s*(min)\\s*(\\()\\s*(\\d+)\\s*(\\))",
          "captures": {
            "1": { "name": "keyword.operator.at.spit" },
            "2": { "name": "keyword.other.selector.spit" },
            "3": { "name": "punctuation.section.parens.spit" },
            "4": { "name": "constant.numeric.spit" },
            "5": { "name": "punctuation.section.parens.spit" }
          }
        },
        { "name": "storage.modifier.cardinality.spit", "match": "\\bmany\\b" },
        { "name": "keyword.other.selector.spit", "match": "\\bmin\\b" },
        { "name": "keyword.operator.at.spit", "match": "@" },
        { "name": "punctuation.separator.comma.spit", "match": "," },
        { "include": "#type-reference" }
      ]
    },
    "product-declaration": {
      "comment": "A record of a source with no dimensions, such as `testset`, alone on its line.",
      "match": "^(\\s*)([A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*)\\s*$",
      "captures": {
        "2": { "name": "variable.other.product.spit" }
      }
    },
    "invocation": {
      "match": "^(\\s*)([A-Za-z_][A-Za-z0-9_]*)\\s*(=)\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(\\()",
      "captures": {
        "2": { "name": "variable.other.product.spit" },
        "3": { "name": "keyword.operator.assignment.spit" },
        "4": { "name": "entity.name.function.spit" },
        "5": { "name": "punctuation.definition.arguments.begin.spit" }
      }
    },
    "inventory-entry": {
      "comment": "A record; its source's path rule gives its file.",
      "match": "^(\\s*)([A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*)(\\[)([^\\]]*)(\\])\\s*(?=#|$)",
      "captures": {
        "2": { "name": "variable.other.product.spit" },
        "3": { "name": "punctuation.definition.dimensions.begin.spit" },
        "4": { "patterns": [{ "include": "#dimension-assignment-list" }] },
        "5": { "name": "punctuation.definition.dimensions.end.spit" }
      }
    },
    "context-entry": {
      "match": "^(\\s*)(\\[)([^\\]]*)(\\])\\s*$",
      "captures": {
        "2": { "name": "punctuation.definition.dimensions.begin.spit" },
        "3": { "patterns": [{ "include": "#dimension-assignment-list" }] },
        "4": { "name": "punctuation.definition.dimensions.end.spit" }
      }
    },
    "command-line": {
      "begin": "^(\\s*)(verify)\\s+",
      "beginCaptures": {
        "2": { "name": "keyword.control.verify.spit" }
      },
      "end": "$",
      "patterns": [{ "include": "#placeholder" }]
    },
    "dimension-list-inner": {
      "patterns": [
        { "name": "punctuation.definition.dimensions.begin.spit", "match": "\\[" },
        { "name": "punctuation.definition.dimensions.end.spit", "match": "\\]" },
        { "name": "punctuation.separator.comma.spit", "match": "," },
        { "name": "variable.parameter.dimension.spit", "match": "[A-Za-z_][A-Za-z0-9_]*" }
      ]
    },
    "dimension-assignment-list": {
      "patterns": [
        {
          "match": "([A-Za-z_][A-Za-z0-9_]*)(=)([A-Za-z0-9_]+)",
          "captures": {
            "1": { "name": "variable.parameter.dimension.spit" },
            "2": { "name": "keyword.operator.assignment.spit" },
            "3": { "name": "constant.character.dimension-value.spit" }
          }
        },
        { "name": "punctuation.separator.comma.spit", "match": "," }
      ]
    },
    "type-reference": {
      "patterns": [
        {
          "match": "\\b([A-Z][A-Za-z0-9_]*)(<)([^>]*)(>)",
          "captures": {
            "1": { "name": "support.type.spit" },
            "2": { "name": "punctuation.definition.typeparameters.begin.spit" },
            "3": { "patterns": [{ "name": "support.type.spit", "match": "[A-Za-z_][A-Za-z0-9_]*" }, { "name": "punctuation.separator.comma.spit", "match": "," }] },
            "4": { "name": "punctuation.definition.typeparameters.end.spit" }
          }
        },
        { "name": "support.type.spit", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" }
      ]
    },
    "word-comment": {
      "comment": "As in SPIT, `#` starts a comment only at the start of a word.",
      "name": "comment.line.number-sign.spit",
      "match": "(?:^|(?<=\\s))#.*$"
    },
    "brace-escape": {
      "name": "constant.character.escape.brace.spit",
      "match": "\\{\\{|\\}\\}"
    },
    "path-group": {
      "patterns": [
        {
          "comment": "`[[` and `]]` are literal brackets.",
          "name": "constant.character.escape.bracket.spit",
          "match": "\\[\\[|\\]\\]"
        },
        {
          "comment": "`[...]`: part of a path a product keeps only when each placeholder in it has a value.",
          "match": "\\[|\\]",
          "name": "punctuation.definition.optional.spit"
        }
      ]
    },
    "path-placeholder": {
      "patterns": [
        {
          "comment": "SPIT's own placeholders, which take `@` to tell them from dimensions.",
          "match": "(\\{)(@(?:product|entities|labels|stage))(\\})",
          "captures": {
            "1": { "name": "punctuation.definition.template-expression.begin.spit" },
            "2": { "name": "variable.language.placeholder.spit" },
            "3": { "name": "punctuation.definition.template-expression.end.spit" }
          }
        },
        {
          "comment": "A dimension of the product.",
          "match": "(\\{)([A-Za-z_][A-Za-z0-9_]*)(\\})",
          "captures": {
            "1": { "name": "punctuation.definition.template-expression.begin.spit" },
            "2": { "name": "variable.parameter.placeholder.dimension.spit" },
            "3": { "name": "punctuation.definition.template-expression.end.spit" }
          }
        }
      ]
    },
    "placeholder": {
      "patterns": [
        { "include": "#brace-escape" },
        {
          "comment": "`{image.dir}` and `{image.stem}`: an output's folder, and its file name without its extension. `{@output.dir}` and `{@output.stem}` are the unnamed output's.",
          "match": "(\\{)(?:(@output)|([A-Za-z_][A-Za-z0-9_]*))(\\.)(dir|stem)(\\})",
          "captures": {
            "1": { "name": "punctuation.definition.template-expression.begin.spit" },
            "2": { "name": "variable.language.placeholder.spit" },
            "3": { "name": "variable.parameter.placeholder.spit" },
            "4": { "name": "punctuation.accessor.spit" },
            "5": { "name": "variable.other.property.spit" },
            "6": { "name": "punctuation.definition.template-expression.end.spit" }
          }
        },
        {
          "comment": "`{@output}`, the path of an operation's single unnamed output; its `@` marks a placeholder SPIT supplies.",
          "match": "(\\{)(@output|@path)(\\})",
          "captures": {
            "1": { "name": "punctuation.definition.template-expression.begin.spit" },
            "2": { "name": "variable.language.placeholder.spit" },
            "3": { "name": "punctuation.definition.template-expression.end.spit" }
          }
        },
        { "name": "variable.parameter.placeholder.spit", "match": "\\{[^}]*\\}" }
      ]
    },
    "expression": {
      "patterns": [
        {
          "comment": "A `/` that makes a source a folder, alone or after its extension: `source dicom : Dicom / [sub]`, `source store .zarr/`.",
          "name": "constant.other.extension.folder.spit",
          "match": "(?<=\\s)(?:(?:\\.[A-Za-z0-9_-]+)+)?/(?=\\s*(?:#|$|\\[|@))"
        },
        {
          "comment": "The extension a source declares, before its dimensions or at the end of its line: `source events : Events .tsv [sub]`, `source gps : Track .gpx`.",
          "name": "constant.other.extension.spit",
          "match": "(?<=\\s)(?:\\.[A-Za-z0-9_-]+)+(?=\\s*(?:#|$|\\[|@|beside\\b))"
        },
        { "include": "#check-clause" },
        {
          "match": "\\b(beside)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.beside.spit" },
            "2": { "name": "variable.other.product.spit" }
          }
        },
        { "name": "keyword.control.spit", "match": "\\b(require|exclude|per|verify|check|use|from|as|source|dimensions|discover|operation|command|path)\\b" },
        { "name": "keyword.other.discovery.spit", "match": "\\bdirs\\b" },
        { "name": "storage.modifier.cardinality.spit", "match": "\\bmany\\b" },
        { "name": "keyword.other.selector.spit", "match": "\\b(vary|where|same|each|min)\\b" },
        { "include": "#strings" },
        { "name": "keyword.operator.at.spit", "match": "@" },
        { "name": "keyword.operator.arrow.spit", "match": "->" },
        { "name": "keyword.operator.comparison.spit", "match": ">=|<=|=" },
        { "name": "constant.numeric.spit", "match": "\\b\\d+\\b" },
        { "include": "#type-reference" },
        { "include": "#placeholder" },
        { "name": "punctuation.separator.comma.spit", "match": "," },
        { "name": "punctuation.section.parens.spit", "match": "[()]" },
        { "name": "variable.other.spit", "match": "[A-Za-z_][A-Za-z0-9_]*" }
      ]
    }
  }
}
