{
  "name": "spit-language",
  "displayName": "SPIT",
  "icon": "icon.png",
  "description": "Live diagnostics for SPIT pipelines and input recipes",
  "version": "0.2.1",
  "publisher": "spit-local",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Linters"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:spit"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "SPIT runs the `spit` executable on the files of the workspace."
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "spit",
        "aliases": ["SPIT"],
        "extensions": [".spit", ".spitin", ".spitout"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "spit",
        "scopeName": "source.spit",
        "path": "./syntaxes/spit.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "SPIT",
      "properties": {
        "spit.executablePath": {
          "type": "string",
          "scope": "machine-overridable",
          "default": "",
          "description": "Path to the SPIT executable. Set in user settings only, so that a workspace cannot choose a program to run. Leave empty to use a sibling SPIT build or the executable on PATH."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test"
  },
  "devDependencies": {
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
