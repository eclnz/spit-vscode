{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["[", "]"],
    ["(", ")"],
    ["<", ">"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "{", "close": "}" }
  ],
  "surroundingPairs": [
    ["[", "]"],
    ["(", ")"],
    ["{", "}"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(stage\\s+[A-Za-z_][A-Za-z0-9_]*|products|operations|pipeline|constraints|commands|sources|contexts)\\s*:\\s*(#.*)?$",
    "decreaseIndentPattern": "^(?!)"
  },
  "folding": {
    "offSide": true
  }
}
